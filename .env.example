# ==============================================================================
# Archon Environment Configuration (copy to .env for local development)
# Never commit .env with real credentials!
# ==============================================================================

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local Docker Compose credentials (used by docker-compose.yml)
POSTGRES_USER=archon
POSTGRES_PASSWORD=archon_dev_password
POSTGRES_DB=archon
POSTGRES_PORT=5432
REDIS_PORT=6379

# Application connection URLs (must match Docker credentials above locally)
DATABASE_URL=postgresql://archon:archon_dev_password@127.0.0.1:5432/archon
REDIS_URL=redis://127.0.0.1:6379

# GitHub Fine-Grained Read-Only PAT (Public Repositories: read-only, no account perms)
# Required outside NODE_ENV=test; keep strictly server-side (never NEXT_PUBLIC_).
GITHUB_TOKEN=ghp_replace_with_readonly_pat_in_phase_3

# Gemini API Free-Tier Key (optional until Phase 6)
GEMINI_API_KEY=

# API Security, CORS & Rate Limiting
# WEB_ORIGIN is required in production (clean http/https origin, no trailing slash)
WEB_ORIGIN=http://localhost:3000
INGEST_RATE_LIMIT_PER_HOUR=5
# Number of trusted reverse-proxy hops (0 disables; 1 or 2 on Render; never boolean true)
TRUST_PROXY_HOPS=1

# Guardrails & Free-Tier Tunables
MAX_SUPPORTED_FILES=500
MAX_REPO_SIZE_MB=50
HUB_THRESHOLD=30

# Set true on Render $0 free tier to run BullMQ worker inside the API process
RUN_EMBEDDED_WORKER=false