# Enforce LF line endings across Windows dev machines and Linux containers
* text=auto eol=lf

# Explicitly mark common text/config formats as LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.env.example text eol=lf
Dockerfile text eol=lf

# Keep PowerShell scripts Windows-friendly if any are added later
*.ps1 text eol=crlf

# Prevent git from corrupting binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary